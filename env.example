# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3001

# Database (SQLite, volume-mounted)
DATABASE_URL=sqlite:///data/showrunner.db

# TMDB (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Notifications (optional — leave blank to disable)
SLACK_WEBHOOK_URL=

# Timezone (IANA name) — used for "today" comparisons and the resync cron
TIMEZONE=America/New_York

# Schedule
# Cron expression for nightly TMDB resync (6-field: sec min hour dom mon dow).
# Interpreted in TIMEZONE above — default = 6:00 AM local.
RESYNC_CRON=0 0 6 * * *
# Minutes between checks for episodes airing today
NOTIFICATION_CHECK_INTERVAL_MINUTES=60

# Logging
RUST_LOG=info

# CORS — leave blank for same-origin (default), set to "*" for permissive
CORS_ALLOWED_ORIGIN=
