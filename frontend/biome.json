{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"files": {
		"includes": ["**", "!dist", "!coverage"]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"style": {
				"noDescendingSpecificity": "off",
				"noNonNullAssertion": "off",
				"useComponentExportOnlyModules": {
					"level": "error",
					"options": {
						"allowConstantExport": true
					}
				}
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
